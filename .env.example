# Copy this file to `.env` and fill in real values for LOCAL runs.
# In GitHub Actions these come from repository secrets instead (see README).

# --- Oura ---
# Personal Access Token: https://cloud.ouraring.com/personal-access-tokens
OURA_PAT=your_oura_personal_access_token

# --- Email (Resend) ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
MAIL_TO=you@example.com
# Sender address. Defaults to Resend's sandbox address below if unset — fine
# for personal use with no domain setup. Verify your own domain in Resend
# later and set this to an address on it (e.g. alerts@yourdomain.com).
MAIL_FROM=onboarding@resend.dev

# --- Optional ---
# Set to "false" only if running behind a corporate network that breaks TLS
# (self-signed cert injection). Leave unset/true everywhere else, incl. Actions.
OURA_VERIFY_TLS=true
